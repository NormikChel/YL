~ YL v2 — демонстрация всех фич

⊕ "math.yl" as m

~ --- типы ---
¤ x :int = 5
¤ имя :str = "Аня"
¤ флаг :bool = ☑

» "x =", x, "имя =", имя, "флаг =", флаг

~ --- деструктуризация ---
¤ [первый, второй, третий] = [10, 20, 30]
» "первый, второй, третий =", первый, второй, третий

¤ ⟪"a", "b"⟫ = ⟪"a": 1, "b": 2⟫
» "a, b =", a, b

~ --- замыкания + map/filter/reduce ---
¤ удвой = λ (n) ⟦ ^ n * 2 ⟧
¤ числа = [1, 2, 3, 4, 5]
» "map x2:", map(числа, удвой)
» "filter >2:", filter(числа, λ (n) ⟦ ^ n > 2 ⟧)
» "reduce +:", reduce(числа, λ (a, b) ⟦ ^ a + b ⟧, 0)

~ --- модуль ---
» "m.квадрат(6) =", m.квадрат(6)
» "m.куб(3) =", m.куб(3)
» "m.сумма([1,2,3]) =", m.сумма([1, 2, 3])
» "m.PI =", m.PI

~ --- try/catch/finally ---
‼ ⟦
    ¤ r = 10 / 0
    » "не выполнится"
⟧ ⁇ e ⟦
    » "Поймали:", e
⟧ ⌦ ⟦
    » "finally выполнился"
⟧

~ --- break / continue ---
# i = 0 .. 10 ⟦
    ? i == 3 ⟦ ↻ ⟧
    ? i == 6 ⟦ ⊘ ⟧
    » "i =", i
⟧

~ --- assert + eval ---
≡ 2 + 2 == 4, "математика сломалась"
¤ код = "1 + 2 * 3"
» "eval(", код, ") =", eval(код)

~ --- файлы ---
writefile("out.txt", "привет из YL\n")
appendfile("out.txt", "вторая строка\n")
» "файл существует:", exists("out.txt")
» "содержимое:", readfile("out.txt")
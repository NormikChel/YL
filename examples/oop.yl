‡ Животное ⟦
    ⋔ init(имя :str) ⟦
        this.имя = имя
    ⟧
    ⋔ голос() ⟦
        ^ "..."
    ⟧
    ⋔ сказать() ⟦
        » this.имя + " говорит: " + this.голос()
    ⟧
⟧

‡ Собака † Животное ⟦
    ⋔ init(имя :str, порода :str) ⟦
        this.имя = имя
        this.порода = порода
    ⟧
    ⋔ голос() ⟦ ^ "Гав!" ⟧
⟧

‡ Кот † Животное ⟦
    ⋔ голос() ⟦ ^ "Мяу" ⟧
⟧

¤ рекс = ⇢ Собака("Рекс", "овчарка")
¤ борис = ⇢ Кот("Борис")

рекс.сказать()
борис.сказать()

» "Порода Рекса:", рекс.порода
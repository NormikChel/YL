~ std/string.yl
§ capital(s) ⟦ ^ upper(s[0]) + lower(s[1]) ⟧
§ реверс(s) ⟦ ¤ o = ""; # i = 0 .. len(s) ⟦ o = s[len(s) - i - 1] + o ⟧ ^ o ⟧
§ is_digit(s) ⟦ ¤ ok = ☑; # i = 0 .. len(s) ⟦ ¤ c = s[i]; ? !(c >= "0" && c <= "9") ⟦ ok = ☐ ⟧ ⟧ ^ ok ⟧
§ words(s) ⟦ ^ split(s, " ") ⟧
§ lines(s) ⟦ ^ split(s, "\n") ⟧
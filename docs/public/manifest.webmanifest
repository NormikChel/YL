{
    "id": "/",
    "name": "YL - Yankee Language",
    "short_name": "YL",
    "description": "Esoteric programming language on PHP with unicode syntax",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
    ],
    "orientation": "any",
    "background_color": "#0f0f17",
    "theme_color": "#a78bfa",
    "lang": "ru",
    "dir": "ltr",
    "categories": [
        "developer",
        "productivity",
        "education"
    ],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icon-192.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshot-wide.png",
            "sizes": "1200x630",
            "type": "image/png",
            "form_factor": "wide",
            "label": "YL docs on desktop"
        },
        {
            "src": "/screenshot-mobile.png",
            "sizes": "390x844",
            "type": "image/png",
            "label": "YL docs on mobile"
        }
    ],
    "shortcuts": [
        {
            "name": "Синтаксис",
            "short_name": "Syntax",
            "description": "YL syntax reference",
            "url": "/guide/syntax",
            "icons": [
                {
                    "src": "/shortcut-96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Stdlib",
            "short_name": "Stdlib",
            "description": "Standard library reference",
            "url": "/guide/stdlib",
            "icons": [
                {
                    "src": "/shortcut-96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Быстрый старт",
            "short_name": "Start",
            "description": "Getting started",
            "url": "/guide/getting-started",
            "icons": [
                {
                    "src": "/shortcut-96.png",
                    "sizes": "96x96",
                    "type": "image/png"
                }
            ]
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+yl",
            "url": "/guide/getting-started?code=%s"
        }
    ]
}

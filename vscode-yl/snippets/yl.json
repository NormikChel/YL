{
    "Функция": {
        "prefix": "fn",
        "body": ["§ ${1:имя}(${2:параметры}) ⟦", "\t$0", "⟧"]
    },
    "Объявление переменной": {
        "prefix": "decl",
        "body": "¤ ${1:имя} = ${2:значение}"
    },
    "Печать": {
        "prefix": "print",
        "body": "» $1"
    },
    "If": {
        "prefix": "if",
        "body": ["? ${1:условие} ⟦", "\t$2", "⟧ ¿ ⟦", "\t$3", "⟧"]
    },
    "While": {
        "prefix": "while",
        "body": ["@ ${1:условие} ⟦", "\t$2", "⟧"]
    },
    "Класс": {
        "prefix": "class",
        "body": ["‡ ${1:Имя} ⟦", "\t⋔ init(${2:параметры}) ⟦", "\t\t$0", "\t⟧", "⟧"]
    }
}